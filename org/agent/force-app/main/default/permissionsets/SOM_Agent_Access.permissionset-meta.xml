<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>OM Agent Access</label>
    <description>Lets Agentforce (OM Console Assistant) run its Run Query and Describe Object actions for the user: SomAgentQuery and SomAgentDescribe only read, as the user, on Order Management objects. Grants no data access of its own.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <classAccesses>
        <apexClass>SomAgentDescribe</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>SomAgentQuery</apexClass>
        <enabled>true</enabled>
    </classAccesses>
</PermissionSet>
