<CspTrustedSite xmlns="http://soap.sforce.com/2006/04/metadata">
    <context>LEX</context>
    <description>The app domain Salesforce Order Management Operations Console and OM Service Console share, framed on Order Summary record pages by somConsoleFrame (Salesforce Order Management Operations Console) and orderConsole (Order Console, in org/service-app). Frames only. Replace yourdomain in the URL with your org's My Domain.</description>
    <endpointUrl>https://yourdomain--c.my.salesforce.app</endpointUrl>
    <isActive>true</isActive>
    <isApplicableToConnectSrc>false</isApplicableToConnectSrc>
